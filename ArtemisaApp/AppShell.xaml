<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ArtemisaApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArtemisaApp"
    xmlns:view="clr-namespace:ArtemisaApp.View"
    Shell.FlyoutBehavior="Disabled"
    Title="ArtemisaApp">

    <ShellContent
        ContentTemplate="{DataTemplate view:Login}"
        Route="Login" />

    <ShellContent Route="Principal" ContentTemplate="{DataTemplate view:Principal}" />

</Shell>
