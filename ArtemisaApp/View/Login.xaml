<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
             x:Class="ArtemisaApp.View.Login" BackgroundImageSource="fondo.png">

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="0">
            <Grid HeightRequest="250">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Image Source="logo.png" HeightRequest="120" WidthRequest="120"/>
                </VerticalStackLayout>
            </Grid>

            <Frame
            Margin="20,-60,20,0"
            Padding="30,30"
            CornerRadius="20"
            BackgroundColor="White"
            BorderColor="#2196F3"
            HasShadow="True">
                <VerticalStackLayout Spacing="18">
                    <Label Text="Iniciar sesión"
                       FontAttributes="Bold"
                       FontSize="22"
                       HorizontalOptions="Center"
                       TextColor="Black"
                       Margin="0,0,0,10"/>

                    <Label Text="Email"
                       FontAttributes="None"
                       TextColor="Black"
                       FontSize="16"/>
                    <Frame CornerRadius="15"
                       Padding="0"
                       BorderColor="#2196F3"
                       BackgroundColor="White"
                       HasShadow="False"
                       HeightRequest="50"
                       HorizontalOptions="FillAndExpand">
                        <Entry Placeholder="Email"
                           Text="{Binding User.email}"
                           BackgroundColor="Transparent"
                           TextColor="Black"
                           HeightRequest="50"
                           HorizontalOptions="FillAndExpand"
                           Margin="10,0"/>
                    </Frame>

                    <Label Text="Contraseña"
                       FontAttributes="None"
                       TextColor="Black"
                       FontSize="16"/>
                    <Frame CornerRadius="15"
                       Padding="0"
                       BorderColor="#2196F3"
                       BackgroundColor="White"
                       HasShadow="False"
                       HeightRequest="50"
                       HorizontalOptions="FillAndExpand">
                        <Entry Placeholder="Contraseña"
                           IsPassword="True"
                           Text="{Binding User.password}"
                           BackgroundColor="Transparent"
                           TextColor="Black"
                           HeightRequest="50"
                           HorizontalOptions="FillAndExpand"
                           Margin="10,0"/>
                    </Frame>

                    <Button Text="Iniciar Sesión"
                        Command="{Binding LoginCommand}"
                        HorizontalOptions="FillAndExpand"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        FontSize="20"
                        CornerRadius="20"
                        HeightRequest="55"
                        Margin="0,20,0,0"/>

                    <Button
                        Text="Iniciar con Huella"
                        Command="{Binding FingerprintLoginCommand}"
                        HorizontalOptions="FillAndExpand"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        FontSize="20"
                        CornerRadius="20"
                        HeightRequest="55"
                        Margin="0,10,0,0"/>

                    <HorizontalStackLayout HorizontalOptions="Center" Margin="0,10,0,0">
                        <Label Text="¿No tienes una cuenta?"
                           FontAttributes="None"
                           TextColor="Black"/>
                        <Label Text=" Registrate aquí"
                           FontAttributes="Bold"
                           TextColor="#2196F3">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"   
                                   IsVisible="{Binding IsLoading}" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
