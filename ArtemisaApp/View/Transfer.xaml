<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArtemisaApp.View.Transfer"
             BackgroundColor="#2B2929">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">
            <!-- Barra superior con botón de regreso -->
            <HorizontalStackLayout HeightRequest="40" VerticalOptions="Start" Spacing="10">
                <ImageButton
                    Source="flecha1.png"
                    BackgroundColor="Transparent"
                    WidthRequest="32"
                    HeightRequest="32"
                    Rotation="180"
                    Clicked="Regresar"/>
                <Label Text="Regresar"
                       VerticalOptions="Center"
                       TextColor="White"
                       FontSize="16"/>
            </HorizontalStackLayout>

            <!-- Saldo en cuenta -->
            <Frame BackgroundColor="Black"
                   CornerRadius="0"
                   Padding="20,20,20,10"
                   Margin="0,10,0,0"
                   HasShadow="False">
                <VerticalStackLayout>
                    <Label Text="SALDO EN CUENTA"
                           TextColor="White"
                           FontSize="14"/>
                    <Label Text="{Binding Wallet, StringFormat='${0:F2}'}"
                           TextColor="White"
                           FontSize="28"
                           Margin="0,10,0,0"/>
                    <Label Text="Saldo disponible actualmente"
                           TextColor="White"
                           FontSize="14"
                           Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Formulario de transferencia -->
            <VerticalStackLayout Spacing="18" Margin="0,30,0,0">
                <Label Text="Selecciona la persona"
                   TextColor="White"
                   FontSize="16"/>
                            <Frame CornerRadius="15"
                   Padding="0"
                   BackgroundColor="White"
                   BorderColor="#2196F3"
                   HasShadow="False"
                   HeightRequest="50"
                   Margin="0,0,0,0">
                                <Picker
                    ItemsSource="{Binding Users}"
                    ItemDisplayBinding="{Binding FullName}"
                    SelectedItem="{Binding SelectedUser}"
                    BackgroundColor="Transparent"
                    TextColor="Black"
                    HeightRequest="50"
                    VerticalOptions="Center"
                    Margin="10,0"/>
                </Frame>

                <Label Text="Monto a transferir"
                       TextColor="White"
                       FontSize="16"/>
                <Frame CornerRadius="15"
                       Padding="0"
                       BackgroundColor="White"
                       BorderColor="#2196F3"
                       HasShadow="False"
                       HeightRequest="50"
                       Margin="0,0,0,0">
                    <Entry Placeholder="Monto"
                           Keyboard="Numeric"
                           Text="{Binding Transfer.Amount}"
                           BackgroundColor="Transparent"
                           TextColor="Black"
                           HeightRequest="50"
                           VerticalOptions="Center"
                           Margin="10,0"/>
                </Frame>

                <Label Text="Descripcion"
                       TextColor="White"
                       FontSize="16"/>
                <Frame CornerRadius="15"
                       Padding="0"
                       BackgroundColor="White"
                       BorderColor="#2196F3"
                       HasShadow="False"
                       HeightRequest="50"
                       Margin="0,0,0,0">
                    <Entry Placeholder="Descripción"
                           Text="{Binding Transfer.Description}"
                           BackgroundColor="Transparent"
                           TextColor="Black"
                           HeightRequest="50"
                           VerticalOptions="Center"
                           Margin="10,0"/>
                </Frame>

                <Button Text="Transferir"
                        Command="{Binding TransferCommand}"
                        BackgroundColor="#0084FF"
                        TextColor="White"
                        FontSize="20"
                        CornerRadius="15"
                        HeightRequest="55"
                        Margin="0,30,0,0"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>